dwiz part/1 DRV-BASE "Base du boîtier"

# Pourquoi — l'intention de conception
function "Loge les deux cartes, porte le dissipateur et reçoit le couvercle."

# À quoi elle se raccorde — ses interfaces, le contrat avec les pièces voisines
interface IF1 bolt_pattern side=B face=+Z at=[pwrX, W/2] level=(wall + so) key=pwr_pcb_mount
  partner="Carte de puissance" name="Fixation carte de puissance"
  params screw=M3 pattern={type: rect, nx: 2, ny: 2, dx: 70, dy: 80}
  opts thread=insert standoff={h: so, d: 7.5}
interface IF2 bolt_pattern side=B face=+Z at=[ctlX, W/2] level=(wall + so) key=ctrl_pcb_mount
  partner="Carte de contrôle" name="Fixation carte de contrôle"
  params screw=M3 pattern={type: rect, nx: 2, ny: 2, dx: 50, dy: 80}
  opts thread=insert standoff={h: so, d: 7.5}
interface IF3 bolt_pattern side=B face=+Z at=[L/2, W/2] key=cover_screws partner=Couvercle name="Fixation du couvercle"
  params screw=M3 pattern={type: rect, nx: 2, ny: 2, dx: L - 2*wall - 7, dy: W - 2*wall - 7}
  opts thread=insert depth=8
interface IF4 planar side=B face=+Z at=[L/2, W/2] key=cover_seat partner=Couvercle name="Plan de joint du couvercle"
  params w=L h=W
interface IF5 bolt_pattern side=A face=-Z at=[pwrX, W/2] key=heatsink_mount partner=Dissipateur
  name="Fixation du dissipateur"
  params screw=M4 pattern={type: rect, nx: 2, ny: 2, dx: 60, dy: 66}
  opts depth=(wall + 0.5) head=none
interface IF6 cutout side=A face=-Y at=[ctlX, wall + so + 1.6 + conH/2 + 0.5] key=io_connector
  partner="Faisceau machine" name="Passage du connecteur E/S"
  params shape=rect w=conW h=conH r=1
  opts depth=(wall + 0.5)

# De quoi elle est faite — matière, procédé, matière première, moulage
material PC-ABS
process injection_molding
family enclosure
finish "Grain fin VDI 27, noir"
elec kind=insulator

# Ses poignées — les paramètres que l'on règle
param L 164 min=120 max=260 step=1 unit=mm label=Longueur group=Enveloppe
param W 110 min=80 max=200 step=1 unit=mm label=Largeur group=Enveloppe
param H 42 min=25 max=90 step=1 unit=mm label=Hauteur group=Enveloppe
param wall 2.5 min=1.5 max=4 step=0.1 unit=mm label=Paroi group=Enveloppe
param rc 6 min=2 max=15 step=0.5 unit=mm label="Rayon des coins" group=Détails
param so 6 min=4 max=15 step=0.5 unit=mm label="Hauteur des colonnettes" group=Cartes
param pwrX 47 min=40 max=70 step=0.5 unit=mm label="Centre carte de puissance (X)" group=Cartes
param ctlX 122 min=100 max=140 step=0.5 unit=mm label="Centre carte de contrôle (X)" group=Cartes
param winL 44 min=20 max=60 step=1 unit=mm label="Fenêtre thermique (X)" group=Dissipateur
param winW 50 min=20 max=70 step=1 unit=mm label="Fenêtre thermique (Y)" group=Dissipateur
param conW 18 min=8 max=40 step=1 unit=mm label="Largeur connecteur E/S" group=Connecteur
param conH 9 min=4 max=20 step=1 unit=mm label="Hauteur connecteur E/S" group=Connecteur

# Comment elle se fait — les opérations, dans l'ordre de l'atelier
do extrude id=body name="Volume extérieur" profile={rect: [0, 0, L, W], r: rc} plane=XY length=H
do shell id=shell name=Coque t=wall open=[+Z]
do boss id=posts face=+Z
  at={grid: {origin: [wall + 3.5, wall + 3.5], nx: 2, ny: 2, dx: L - 2*wall - 7, dy: W - 2*wall - 7}}
  name="Bossages du couvercle" start=wall d=7 h=(H - wall)
do pocket id=window face=-Z name="Fenêtre thermique" rect=[pwrX - winL/2, W/2 - winW/2, winL, winW] r=3
  depth=(wall + 0.5)

# Ce qu'il faut savoir — notes du dessin, révision, hypothèses
note "Matière PC/ABS UL94 V-0 à l'épaisseur de paroi."
note "Inserts M3 posés à chaud après moulage."
note "Dépouille 1° sur les parois, à ajouter à l'outillage."
revision A


dwiz part/1 DRV-COVER Couvercle

# Pourquoi — l'intention de conception
function "Ferme le boîtier et protège les cartes."

# À quoi elle se raccorde — ses interfaces, le contrat avec les pièces voisines
interface IF1 bolt_pattern side=A face=-Z at=[L/2, W/2] key=cover_screws partner="Base du boîtier"
  name="Fixation sur la base"
  params screw=M3 pattern={type: rect, nx: 2, ny: 2, dx: sx, dy: sy}
  opts head=none
interface IF2 planar side=A face=-Z at=[L/2, W/2] key=cover_seat partner="Base du boîtier" name="Plan de joint"
  params w=L h=W

# De quoi elle est faite — matière, procédé, matière première, moulage
material PC-ABS
process injection_molding
family plate
elec kind=insulator

# Ses poignées — les paramètres que l'on règle
param L 163 min=120 max=260 step=1 unit=mm label=Longueur group=Enveloppe
param W 110 min=80 max=200 step=1 unit=mm label=Largeur group=Enveloppe
param t 2.5 min=1.5 max=4 step=0.1 unit=mm label=Épaisseur group=Enveloppe
param rc 6 min=2 max=15 step=0.5 unit=mm label="Rayon des coins" group=Détails
param sx 148 min=60 max=250 step=0.5 unit=mm label="Entraxe des vis en X" group=Fixation
param sy 98 min=40 max=190 step=0.5 unit=mm label="Entraxe des vis en Y" group=Fixation

# Comment elle se fait — les opérations, dans l'ordre de l'atelier
do extrude id=lid name=Plaque profile={rect: [0, 0, L, W], r: rc} plane=XY length=t

# Ce qu'il faut savoir — notes du dessin, révision, hypothèses
note "Matière PC/ABS UL94 V-0."
revision A


dwiz part/1 DRV-PWR-PCB "Carte de puissance"

# Pourquoi — l'intention de conception
function "Étage de puissance 400 V : pont de MOSFET, condensateurs du bus, mesure de courant."

# À quoi elle se raccorde — ses interfaces, le contrat avec les pièces voisines
interface IF1 bolt_pattern side=A face=-Z at=[L/2, W/2] key=pwr_pcb_mount partner="Base du boîtier"
  name="Fixation de la carte"
  params screw=M3 pattern={type: rect, nx: 2, ny: 2, dx: mx, dy: my}

# De quoi elle est faite — matière, procédé, matière première, moulage
material FR4
process pcb
family pcb

# Ses poignées — les paramètres que l'on règle
param L 80 min=60 max=120 step=1 unit=mm label=Longueur group=Enveloppe
param W 90 min=60 max=140 step=1 unit=mm label=Largeur group=Enveloppe
param mx 70 min=40 max=110 step=1 unit=mm label="Entraxe des trous en X" group=Fixation
param my 80 min=40 max=130 step=1 unit=mm label="Entraxe des trous en Y" group=Fixation
param gapHV 2.5 min=1 max=10 step=0.1 unit=mm label="Écart entre zones HV+ et HV-" group=Isolation
param gapLV 8 min=3 max=20 step=0.5 unit=mm label="Barrière HV / LV" group=Isolation

# Comment elle se fait — les opérations, dans l'ordre de l'atelier
pcb size=[L, W] r=2 t=1.6
  zone net=HV+ side=top name="Bus HV+" rect=[9, 44, L/2 - 9 - gapHV/2, 36]
  zone net=HV- side=top name="Bus HV-" rect=[L/2 + gapHV/2, 44, L/2 - 9 - gapHV/2, 36]
  zone net=LV side=top name="Commande de grille (LV)" rect=[9, 9, L - 18, 35 - gapLV]
  zone net=HV+ side=bottom name="Plage thermique" rect=[L/2 - 12, 50, 24, 20]
  component Q1 name="Demi-pont A" kind=mosfet at=[22, 62] size=[14, 18, 4.5]
  component Q2 name="Demi-pont B" kind=mosfet at=[58, 62] size=[14, 18, 4.5]
  component C1 name="Condensateur du bus" kind=capacitor at=[22, 80] size=[16, 8, 24]
  component C2 name="Condensateur du bus" kind=capacitor at=[58, 80] size=[16, 8, 24]
  component U3 name="Capteur de courant" kind=sensor at=[40, 30] size=[10, 8, 3]
  component U4 name="Isolateur de grille" kind=optocoupler at=[22, 22] size=[9, 6, 3.5]
  component U5 name="Isolateur de grille" kind=optocoupler at=[58, 22] size=[9, 6, 3.5]
  component J3 name="Liaison carte à carte" kind=connector at=[70, 14] size=[6, 16, 9]
  net HV+ kind=dc voltage=400 floating=true
  net HV- kind=dc voltage=0 floating=true
  net LV kind=dc voltage=12
  net Chassis kind=dc voltage=0
features = []

# Ce qu'il faut savoir — notes du dessin, révision, hypothèses
note "FR4 TG150, 1,6 mm, 2 oz, vernis épargne des deux côtés."
note "Zones HV repérées par sérigraphie."
revision A


dwiz part/1 DRV-CTRL-PCB "Carte de contrôle"

# Pourquoi — l'intention de conception
function "CPU, capteurs, communication et connecteur E/S."

# À quoi elle se raccorde — ses interfaces, le contrat avec les pièces voisines
interface IF1 bolt_pattern side=A face=-Z at=[L/2, W/2] key=ctrl_pcb_mount partner="Base du boîtier"
  name="Fixation de la carte"
  params screw=M3 pattern={type: rect, nx: 2, ny: 2, dx: mx, dy: my}

# De quoi elle est faite — matière, procédé, matière première, moulage
material FR4
process pcb
family pcb

# Ses poignées — les paramètres que l'on règle
param L 60 min=40 max=100 step=1 unit=mm label=Longueur group=Enveloppe
param W 90 min=60 max=140 step=1 unit=mm label=Largeur group=Enveloppe
param mx 50 min=30 max=90 step=1 unit=mm label="Entraxe des trous en X" group=Fixation
param my 80 min=40 max=130 step=1 unit=mm label="Entraxe des trous en Y" group=Fixation

# Comment elle se fait — les opérations, dans l'ordre de l'atelier
pcb size=[L, W] r=2 t=1.6
  zone net=LV side=top name="Logique 12 V / 3,3 V" rect=[8, 12, L - 16, W - 24]
  component U1 name=CPU kind=mcu at=[L/2, 52] size=[14, 14, 1.6]
  component U2 name="Capteur de température" kind=sensor at=[16, 70] size=[5, 4, 1.5]
  component U6 name="Capteur inertiel" kind=sensor at=[44, 70] size=[4, 4, 1.2]
  component J1 name="Connecteur E/S" kind=connector at=[L/2, 6] size=[16, 11, 8]
  component J2 name="Liaison carte à carte" kind=connector at=[8, 30] size=[6, 16, 9]
  component Y1 name=Quartz kind=other at=[44, 38] size=[5, 3.2, 1.2]
  net LV kind=dc voltage=12
features = []

# Ce qu'il faut savoir — notes du dessin, révision, hypothèses
note "FR4 1,6 mm, 4 couches."
revision A


dwiz part/1 DRV-HEATSINK "Dissipateur extrudé"

# Pourquoi — l'intention de conception
function "Évacue la chaleur de l'étage de puissance ; relié au Chassis."

# À quoi elle se raccorde — ses interfaces, le contrat avec les pièces voisines
interface IF1 bolt_pattern side=B face=-Z at=[W/2, L/2] key=heatsink_mount partner="Base du boîtier"
  name="Fixation sous la base"
  params screw=M4 pattern={type: rect, nx: 2, ny: 2, dx: 60, dy: 66}
  opts thread=tapped depth=(base - 1)

# De quoi elle est faite — matière, procédé, matière première, moulage
material AL6063-T5
process extrusion_al
family extrusion
finish "Anodisé noir 10 µm"
elec kind=chassis net=Chassis

# Ses poignées — les paramètres que l'on règle
param W 80 min=50 max=140 step=1 unit=mm label=Largeur group=Enveloppe
param base 7 min=3 max=12 step=0.5 unit=mm label="Épaisseur de la semelle" group=Profil
param fin 20 min=8 max=50 step=1 unit=mm label="Hauteur des ailettes" group=Profil
param tf 2.4 min=1.2 max=4 step=0.1 unit=mm label="Épaisseur d'ailette" group=Profil
param n 10 min=4 max=20 step=1 unit="" label="Nombre d'ailettes" group=Profil
param L 86 min=40 max=200 step=1 unit=mm label="Longueur coupée" group=Enveloppe

# Comment elle se fait — les opérations, dans l'ordre de l'atelier
extrusion axis=Y length=L profile={gen: heatsink, W: W, base: base, fin: fin, tf: tf, n: n}
  outside name="Plage thermique du module" w=44 h=1 at=[W/2, -1] clearance=0.2
features = []

# Ce qu'il faut savoir — notes du dessin, révision, hypothèses
note "Profilé 6063-T5 coupé à longueur, ébavuré."
note "Planéité de la face d'appui 0,1 mm."
revision A


dwiz assembly/1 DRV-ASM "Variateur compact — assemblage général"

# Ce qu'il contient — une ligne par pièce posée
place i1 DRV-BASE fixed=true placement={t: [0, 0, 0], r: [0, 0, 0]}
place i2 DRV-PWR-PCB
place i3 DRV-CTRL-PCB
place i4 DRV-COVER
place i5 DRV-HEATSINK

# Ce qui les tient ensemble — les interfaces accouplées
mate M1 a={inst: i2, iface: IF1} b={inst: i1, iface: IF1} linked=true by=key
mate M2 a={inst: i3, iface: IF1} b={inst: i1, iface: IF2} linked=true by=key
mate M3 a={inst: i4, iface: IF1} b={inst: i1, iface: IF3} linked=true by=key
mate M4 a={inst: i4, iface: IF2} b={inst: i1, iface: IF4} linked=true by=key
mate M5 a={inst: i1, iface: IF5} b={inst: i5, iface: IF1} linked=true by=key

# Ce que l'on vérifie — isolation électrique
isolation levels={"HV+|LV": reinforced, "HV-|LV": reinforced}
  net HV+ kind=dc voltage=400 floating=true
  net HV- kind=dc voltage=0 floating=true
  net LV kind=dc voltage=12
  net Chassis kind=dc voltage=0
  params pollution_degree=2 altitude_m=2000 ovc=II field=A level=basic


dwiz board/1 DRV-CTRL-PCBA "Carte de contrôle du variateur"

# Pourquoi — les fonctions que la carte remplit
description "Reçoit le 24 V, alimente la logique, calcule et pilote l'étage de puissance, mesure la température et le mouvement, communique en CAN."
revision A
function F1 parent=null kind=principale name="Alimenter la logique à partir du 24 V" block=null
  criterion name="Tension d'entrée" level="18 à 30 V" flex=F0
  criterion name=Rails level="5 V 1 A ; 3,3 V 0,3 A" flex=F1
function F2 parent=null kind=principale name="Calculer et piloter l'étage de puissance" block=null
  criterion name="Fréquence de découpage" level="20 kHz" flex=F1
function F3 parent=null kind=principale name="Communiquer avec le système" block=null
  criterion name=Bus level="CAN 500 kbit/s, terminaison commutable" flex=F1
function F4 parent=null kind=principale name="Mesurer la température et le mouvement" block=null
  criterion name=Température level="−20 à 100 °C, ± 2 K" flex=F1
function F5 parent=null kind=principale name="Signaler l'état" block=null
  criterion name=Témoin level="visible capot fermé" flex=F2
function F6 parent=null kind=principale name="Être testable, programmable et fabricable en prototype rapide" block=null
  criterion name=Délai level="carte montée en 10 jours ouvrables" flex=F1
function F7 parent=null kind=contrainte name="Tenir dans le boîtier" block=null
  criterion name=Carte level="60 × 90 mm, 4 vis M3, composants ≤ 9 mm" flex=F0
function F8 parent=null kind=contrainte name="Résister à l'environnement" block=null
  criterion name=Vernis level="acrylique 50 µm, deux faces" flex=F1
function F3.1 parent=F3 kind=technique name="Raccorder la carte : +24V_IN,GND,CAN_H,CAN_L" block=B1 auto=true
  criteria = []
function F1.1 parent=F1 kind=technique
  name="Protéger l'entrée 24 V contre l'inversion, la surtension et le court-circuit" block=B2 auto=true
  criteria = []
function F1.2 parent=F1 kind=technique name="Abaisser 24 V vers 5 V, 1 A" block=B3 auto=true
  criteria = []
function F1.3 parent=F1 kind=technique name="Réguler 5 V vers 3,3 V, 0,3 A, sans bruit de découpage" block=B4 auto=true
  criteria = []
function F2.1 parent=F2 kind=technique name="Calculer et piloter : microcontrôleur 32 bits, 48 broches" block=B5
  auto=true
  criteria = []
function F2.2 parent=F2 kind=technique name="Relier la carte voisine : +5V,GND,PWM_H,PWM_L,AIN1,AIN2,DOUT0,GND"
  block=B6 auto=true
  criteria = []
function F3.2 parent=F3 kind=technique name="Communiquer sur le bus CAN" block=B7 auto=true
  criteria = []
function F4.1 parent=F4 kind=technique name="Mesurer la température (CTN 10 kΩ), filtre à 100 Hz" block=B8 auto=true
  criteria = []
function F4.2 parent=F4 kind=technique name="Mesurer l'accélération et la rotation (6 axes, I²C)" block=B9 auto=true
  criteria = []
function F5.1 parent=F5 kind=technique name="Signaler l'état par une DEL verte" block=B10 auto=true
  criteria = []
function F6.1 parent=F6 kind=technique name="Programmer et déboguer le microcontrôleur" block=B11 auto=true
  criteria = []
function F6.2 parent=F6 kind=technique name="Rendre la carte testable et plaçable en machine" block=B12 auto=true
  criteria = []

# Comment — un bloc de circuit par fonction
block B1 conn_io name="Connecteur d'entrées-sorties" function=F3.1 zone=[1.5, 1.5, 11, 42]
  connect={P1: +24V_IN, P2: GND, P3: CAN_H, P4: CAN_L}
  params signals="+24V_IN,GND,CAN_H,CAN_L"
block B2 input_protection name="Protection d'entrée" function=F1.1 zone=[13, 1.5, 15, 42]
  connect={IN: +24V_IN, OUT: +24V, GND: GND}
  params v=24 i=1
block B3 buck name="Régulateur abaisseur" function=F1.2 zone=[1.5, 61.5, 27, 20]
  connect={VIN: +24V, VOUT: +5V, GND: GND}
  params vin=24 vout=5 iout=1 ripple=30
block B4 ldo name="Régulateur linéaire" function=F1.3 zone=[28.5, 1.5, 14, 28] connect={VIN: +5V, VOUT: +3V3, GND: GND}
  params vin=5 vout=3.3 iout=0.3
block B5 mcu name=Microcontrôleur function=F2.1 zone=[28.5, 29.5, 30, 32] connect={VDD: +3V3, GND: GND, NRST: RESET_N}
  params pins=48 xtal=8 vdd=3.3
block B6 conn_board name="Liaison carte à carte" function=F2.2 zone=[28.5, 62.5, 30, 26.5]
  connect={P1: +5V, P2: GND, P3: PWM_H, P4: PWM_L, P5: AIN1, P6: AIN2, P7: DOUT0, P8: GND}
  params signals="+5V,GND,PWM_H,PWM_L,AIN1,AIN2,DOUT0,GND"
block B7 can name="Interface CAN" function=F3.2 zone=[1.5, 44, 27, 17]
  connect={VCC: +5V, VIO: +3V3, GND: GND, TXD: CAN_TX, RXD: CAN_RX, CANH: CAN_H, CANL: CAN_L}
  params term=1 choke=0 vio=3.3
block B8 ntc name="Mesure de température par CTN" function=F4.1 zone=[43, 1.5, 6, 15]
  connect={VREF: +3V3, GND: GND, OUT: AIN0}
  params vref=3.3 rp=10 fc=100
block B9 imu name="Centrale inertielle" function=F4.2 zone=[49, 1.5, 9.5, 15]
  connect={VDD: +3V3, GND: GND, SCL: I2C_SCL, SDA: I2C_SDA, INT1: IMU_INT}
  params vdd=3.3 pull=1
block B10 led name="Témoin lumineux" function=F5.1 zone=[55.5, 17, 3.5, 12.5] connect={IN: LED_STATUS, GND: GND}
  params v=3.3 i=2 color=verte
block B11 conn_swd name="Connecteur de programmation" function=F6.1 zone=[43, 17, 12, 12.5]
  connect={VREF: +3V3, SWDIO: SWDIO, SWCLK: SWCLK, NRST: RESET_N, GND: GND}
  params vdd=3.3
block B12 test name="Points de test et mires" function=F6.2 zone=[1.5, 82, 27, 7]
  connect={T1: +24V, T2: +5V, T3: +3V3, T4: GND}
  params nets="+24V,+5V,+3V3,GND" fiducials=3

# Avec quoi — les composants, et les nets qui les relient
